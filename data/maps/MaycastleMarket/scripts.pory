    ITEM_FRESH_WATER
    ITEM_SODA_POP
    ITEM_LEMONADE
    ITEM_MOOMOO_MILK
}

script LassText {
    msgbox("Shame they dont sell more beauty
            produtcs here. I will have to travle
            to another town to get what I want.", MSGBOX_NPC)
    end
}

script Boy1Text {
    msgbox("I here they sell some items not avalible
            at the front from that door sometimes.", MSGBOX_NPC)
    end 
}

script Boy2Text {
    msgbox("Mum wont stop shopping all the time!
            All i want to do is play with my Maschiff
            at home.", MSGBOX_NPC)
    end
}

script WomanText {
    msgbox("They have a variety of products here.
            Everything from daily necessities, to
            trainer supplies", MSGBOX_NPC)
    end 
}

script OldWomanText {
    msgbox("I'm here to buy my Herdier some treats.
            He loves Lava Cookies.", MSGBOX_NPC)
    end 
}

script Herdier {
    playmoncry(SPECIES_HERDIER, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox("Ruff", MSGBOX_NPC)
    end
}

script DoorText {
    msgbox("The Door is locked. 
            A note says to come back later.", MSGBOX_NPC)
    end 
}