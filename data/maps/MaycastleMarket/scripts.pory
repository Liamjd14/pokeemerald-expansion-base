mapscripts MaycastleMarket_MapScripts {}

script MarketMart1 {
    lock
    faceplayer
	message("Welcome,\n How can I help you?")
	waitmessage
	pokemart(MarketMart1Shop)
	msgbox("Come again soon.")
    release
}

mart MarketMart1Shop {
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_ULTRA_BALL
    ITEM_HEAL_BALL
    ITEM_NET_BALL
    ITEM_NEST_BALL
    ITEM_DIVE_BALL
    ITEM_DUSK_BALL
    ITEM_TIMER_BALL
    ITEM_QUICK_BALL
    ITEM_REPEAT_BALL
    ITEM_LUXURY_BALL
}

